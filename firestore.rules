rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'rupk03793@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotBlocked() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/user_access/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.status != 'blocked'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll(['userId', 'watchlist', 'currencySymbol', 'currencyPlacement', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'watchlist', 'currencySymbol', 'currencyPlacement', 'themeMode', 'currentLanguage', 'planTier', 'planExpiresAt', 'adFree', 'organizationId', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.watchlist is list && data.watchlist.size() <= 40
        && (data.watchlist.size() == 0 || (data.watchlist[0] is string && data.watchlist[0].size() <= 24))
        && data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8
        && data.currencyPlacement in ['before', 'after']
        && (!('themeMode' in data) || data.themeMode in ['system', 'light', 'dark'])
        && (!('currentLanguage' in data) || (data.currentLanguage is string && data.currentLanguage.size() >= 2 && data.currentLanguage.size() <= 16))
        && (!('planTier' in data) || data.planTier in ['free', 'day', 'pro', 'team'])
        && (!('planExpiresAt' in data) || (data.planExpiresAt is string && data.planExpiresAt.size() <= 64))
        && (!('adFree' in data) || data.adFree is bool)
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'merchant', 'amount', 'category', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'merchant', 'amount', 'category', 'status', 'paymentMethod', 'invoiceId', 'upiReference', 'notes', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && data.merchant is string && data.merchant.size() >= 1 && data.merchant.size() <= 160
        && (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.status in ['completed', 'pending']
        && (!('paymentMethod' in data) || data.paymentMethod in ['UPI', 'CARD', 'CASH', 'SCAN_RECEIPT', 'INVOICE', 'PAYPAL'])
        && (!('invoiceId' in data) || (data.invoiceId is string && data.invoiceId.size() <= 128))
        && (!('upiReference' in data) || (data.upiReference is string && data.upiReference.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvoice(data, userId) {
      return data.keys().hasAll(['userId', 'invoiceNumber', 'date', 'clientName', 'industry', 'items', 'subtotal', 'taxTotal', 'discountTotal', 'grandTotal', 'currency', 'paymentStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'invoiceNumber', 'date', 'dueDate', 'senderName', 'senderDetails', 'senderTaxId', 'clientName', 'clientDetails', 'clientEmail', 'clientTaxId', 'industry', 'templateStyle', 'paperFormat', 'items', 'subtotal', 'taxTotal', 'discountTotal', 'grandTotal', 'currency', 'notes', 'upiId', 'payeeName', 'paypalId', 'paymentRegion', 'paymentStatus', 'paidAt', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 64
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 32
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 32))
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 160))
        && (!('senderDetails' in data) || (data.senderDetails is string && data.senderDetails.size() <= 400))
        && (!('senderTaxId' in data) || (data.senderTaxId is string && data.senderTaxId.size() <= 64))
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 160
        && (!('clientDetails' in data) || (data.clientDetails is string && data.clientDetails.size() <= 400))
        && (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 254))
        && (!('clientTaxId' in data) || (data.clientTaxId is string && data.clientTaxId.size() <= 64))
        && data.industry in ['RETAIL', 'TECH', 'DINING', 'HEALTHCARE', 'SERVICES']
        && (!('templateStyle' in data) || data.templateStyle in ['swiss', 'classic', 'minimal', 'corporate', 'executive'])
        && (!('paperFormat' in data) || data.paperFormat in ['a4', 'letter', 'thermal80'])
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.items[0] is map
        && (data.subtotal is int || data.subtotal is float) && data.subtotal >= 0 && data.subtotal <= 1000000000
        && (data.taxTotal is int || data.taxTotal is float) && data.taxTotal >= 0 && data.taxTotal <= 1000000000
        && (data.discountTotal is int || data.discountTotal is float) && data.discountTotal >= 0 && data.discountTotal <= 1000000000
        && (data.grandTotal is int || data.grandTotal is float) && data.grandTotal >= 0 && data.grandTotal <= 1000000000
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 12
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 600))
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 120))
        && (!('payeeName' in data) || (data.payeeName is string && data.payeeName.size() <= 120))
        && (!('paypalId' in data) || (data.paypalId is string && data.paypalId.size() <= 254))
        && (!('paymentRegion' in data) || data.paymentRegion in ['IN', 'INTL'])
        && data.paymentStatus in ['unpaid', 'paid', 'pending']
        && (!('paidAt' in data) || (data.paidAt is string && data.paidAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockPortfolio(data, userId) {
      return data.keys().hasAll(['userId', 'brokerName', 'totalValue', 'totalInvested', 'currency', 'holdings', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'brokerName', 'totalValue', 'totalInvested', 'currency', 'notes', 'holdings', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.brokerName is string && data.brokerName.size() >= 1 && data.brokerName.size() <= 80
        && (data.totalValue is int || data.totalValue is float) && data.totalValue >= 0 && data.totalValue <= 10000000000
        && (data.totalInvested is int || data.totalInvested is float) && data.totalInvested >= 0 && data.totalInvested <= 10000000000
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.holdings is list && data.holdings.size() <= 50
        && (data.holdings.size() == 0 || data.holdings[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidGoal(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'visualUrl', 'type', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'visualUrl', 'type', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.visualUrl is string && data.visualUrl.size() >= 1 && data.visualUrl.size() <= 700000
        && data.type in ['IMAGE', 'VIDEO']
        && data.createdAt is timestamp;
    }

    function isValidOrganization(data, orgId) {
      return data.keys().hasAll(['orgId', 'name', 'industry', 'planTier', 'seatCount', 'monthlyRevenueUsd', 'status', 'ownerUserId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['orgId', 'name', 'industry', 'planTier', 'seatCount', 'monthlyRevenueUsd', 'status', 'ownerUserId', 'billingEmail', 'notes', 'createdAt', 'updatedAt'])
        && data.orgId is string && data.orgId == orgId && isValidId(data.orgId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.industry is string && data.industry.size() >= 1 && data.industry.size() <= 80
        && data.planTier in ['free', 'pro', 'team', 'enterprise']
        && (data.seatCount is int || data.seatCount is float) && data.seatCount >= 1 && data.seatCount <= 100000
        && (data.monthlyRevenueUsd is int || data.monthlyRevenueUsd is float) && data.monthlyRevenueUsd >= 0 && data.monthlyRevenueUsd <= 10000000
        && data.status in ['active', 'trial', 'paused', 'churned']
        && data.ownerUserId is string && isValidId(data.ownerUserId)
        && (!('billingEmail' in data) || (data.billingEmail is string && data.billingEmail.size() <= 254))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['eventType', 'featureWindow', 'userId', 'createdAt'])
        && data.keys().hasOnly(['eventType', 'featureWindow', 'userId', 'organizationId', 'metadata', 'revenueImpactUsd', 'createdAt'])
        && data.eventType in ['feature_view', 'invoice_created', 'ocr_scan', 'voice_session', 'ad_impression', 'affiliate_click', 'pro_upgrade', 'org_created', 'vision_collab']
        && data.featureWindow is string && data.featureWindow.size() >= 1 && data.featureWindow.size() <= 64
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && (!('organizationId' in data) || (data.organizationId is string && data.organizationId.size() <= 128))
        && (!('metadata' in data) || (data.metadata is string && data.metadata.size() <= 300))
        && (!('revenueImpactUsd' in data) || ((data.revenueImpactUsd is int || data.revenueImpactUsd is float) && data.revenueImpactUsd >= 0 && data.revenueImpactUsd <= 1000000))
        && data.createdAt is timestamp;
    }

    function isValidGatewayPayment(data, paymentId) {
      return data.keys().hasAll(['paymentId', 'userId', 'planTier', 'billingCycle', 'region', 'currency', 'amount', 'amountUsdEquivalent', 'paymentRail', 'connector', 'status', 'referenceCode', 'createdAt'])
        && data.keys().hasOnly(['paymentId', 'userId', 'userEmail', 'userName', 'planTier', 'billingCycle', 'region', 'currency', 'amount', 'amountUsdEquivalent', 'paymentRail', 'connector', 'status', 'referenceCode', 'createdAt'])
        && data.paymentId is string && data.paymentId == paymentId && isValidId(data.paymentId)
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 254))
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 120))
        && data.planTier in ['free', 'day', 'pro', 'team']
        && data.billingCycle in ['daily', 'monthly', 'annual']
        && data.region in ['IN', 'INTL']
        && data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 10000000
        && (data.amountUsdEquivalent is int || data.amountUsdEquivalent is float) && data.amountUsdEquivalent >= 0 && data.amountUsdEquivalent <= 1000000
        && data.paymentRail in ['UPI_QR', 'UPI_ID', 'PAYPAL', 'CARD', 'WALLET']
        && data.connector is string && data.connector.size() >= 1 && data.connector.size() <= 80
        && data.status in ['succeeded', 'processing', 'requires_action', 'failed']
        && data.referenceCode is string && data.referenceCode.size() >= 1 && data.referenceCode.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidIdeationBoard(data, boardId) {
      return data.keys().hasAll(['boardId', 'title', 'roomCode', 'ownerUserId', 'nodes', 'slides', 'meetingNotes', 'updatedAt'])
        && data.keys().hasOnly(['boardId', 'title', 'roomCode', 'ownerUserId', 'nodes', 'slides', 'meetingNotes', 'updatedAt'])
        && data.boardId is string && data.boardId == boardId && isValidId(data.boardId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 40
        && data.ownerUserId is string && isValidId(data.ownerUserId)
        && data.nodes is list && data.nodes.size() <= 150
        && data.slides is list && data.slides.size() <= 40
        && data.meetingNotes is list && data.meetingNotes.size() <= 200
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['userId', 'email', 'role', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role in ['owner', 'admin']
        && data.createdAt is timestamp;
    }

    function isValidPayoutSettings(data, userId) {
      return data.keys().hasAll(['userId', 'upiId', 'payeeName', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'upiId', 'payeeName', 'bankName', 'accountHolder', 'accountNumber', 'ifscCode', 'updatedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 120
        && data.payeeName is string && data.payeeName.size() >= 1 && data.payeeName.size() <= 120
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120))
        && (!('accountHolder' in data) || (data.accountHolder is string && data.accountHolder.size() <= 120))
        && (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 40))
        && (!('ifscCode' in data) || (data.ifscCode is string && data.ifscCode.size() <= 32))
        && data.updatedAt is timestamp;
    }

    function isValidPlatformPayoutPrivate(data) {
      return data.keys().hasAll(['payeeName', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['upiId', 'payeeName', 'bankName', 'accountHolder', 'accountNumber', 'ifscCode', 'paypalEnabled', 'paypalEnvironment', 'paypalClientId', 'paypalClientSecret', 'paypalMerchantEmail', 'updatedBy', 'updatedAt'])
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 120))
        && data.payeeName is string && data.payeeName.size() >= 1 && data.payeeName.size() <= 120
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120))
        && (!('accountHolder' in data) || (data.accountHolder is string && data.accountHolder.size() <= 120))
        && (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 40))
        && (!('ifscCode' in data) || (data.ifscCode is string && data.ifscCode.size() <= 32))
        && (!('paypalEnabled' in data) || data.paypalEnabled is bool)
        && (!('paypalEnvironment' in data) || data.paypalEnvironment in ['sandbox', 'live'])
        && (!('paypalClientId' in data) || (data.paypalClientId is string && data.paypalClientId.size() <= 200))
        && (!('paypalClientSecret' in data) || (data.paypalClientSecret is string && data.paypalClientSecret.size() <= 200))
        && (!('paypalMerchantEmail' in data) || (data.paypalMerchantEmail is string && data.paypalMerchantEmail.size() <= 254))
        && data.updatedBy is string && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidPlatformPayoutPublic(data) {
      return data.keys().hasAll(['payeeName', 'hasPayoutConfigured', 'updatedAt'])
        && data.keys().hasOnly(['upiId', 'payeeName', 'bankName', 'accountNumberLast4', 'paypalEnabled', 'paypalEnvironment', 'paypalClientId', 'paypalMerchantEmail', 'hasPaypalConfigured', 'hasPayoutConfigured', 'updatedAt'])
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 120))
        && data.payeeName is string && data.payeeName.size() >= 1 && data.payeeName.size() <= 120
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120))
        && (!('accountNumberLast4' in data) || (data.accountNumberLast4 is string && data.accountNumberLast4.size() <= 8))
        && (!('paypalEnabled' in data) || data.paypalEnabled is bool)
        && (!('paypalEnvironment' in data) || data.paypalEnvironment in ['sandbox', 'live'])
        && (!('paypalClientId' in data) || (data.paypalClientId is string && data.paypalClientId.size() <= 200))
        && (!('paypalMerchantEmail' in data) || (data.paypalMerchantEmail is string && data.paypalMerchantEmail.size() <= 254))
        && (!('hasPaypalConfigured' in data) || data.hasPaypalConfigured is bool)
        && data.hasPayoutConfigured is bool
        && data.updatedAt is timestamp;
    }

    function isValidPlatformAiImagePrivate(data) {
      return data.keys().hasAll(['aiHordeEnabled', 'cloudflareEnabled', 'huggingfaceEnabled', 'queueTimeoutSec', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['aiHordeEnabled', 'aiHordeApiKey', 'cloudflareEnabled', 'cloudflareAccountId', 'cloudflareApiToken', 'huggingfaceEnabled', 'huggingfaceToken', 'queueTimeoutSec', 'updatedBy', 'updatedAt'])
        && data.aiHordeEnabled is bool
        && (!('aiHordeApiKey' in data) || (data.aiHordeApiKey is string && data.aiHordeApiKey.size() <= 120))
        && data.cloudflareEnabled is bool
        && (!('cloudflareAccountId' in data) || (data.cloudflareAccountId is string && data.cloudflareAccountId.size() <= 120))
        && (!('cloudflareApiToken' in data) || (data.cloudflareApiToken is string && data.cloudflareApiToken.size() <= 250))
        && data.huggingfaceEnabled is bool
        && (!('huggingfaceToken' in data) || (data.huggingfaceToken is string && data.huggingfaceToken.size() <= 250))
        && data.queueTimeoutSec is number && data.queueTimeoutSec >= 10 && data.queueTimeoutSec <= 120
        && data.updatedBy is string && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidPlatformAiImagePublic(data) {
      return data.keys().hasAll(['aiHordeEnabled', 'cloudflareEnabled', 'huggingfaceEnabled', 'queueTimeoutSec', 'activeTurboMode', 'updatedAt'])
        && data.keys().hasOnly(['aiHordeEnabled', 'hasAiHordeKey', 'cloudflareEnabled', 'hasCloudflareConfigured', 'huggingfaceEnabled', 'hasHuggingfaceConfigured', 'queueTimeoutSec', 'activeTurboMode', 'updatedAt'])
        && data.aiHordeEnabled is bool
        && (!('hasAiHordeKey' in data) || data.hasAiHordeKey is bool)
        && data.cloudflareEnabled is bool
        && (!('hasCloudflareConfigured' in data) || data.hasCloudflareConfigured is bool)
        && data.huggingfaceEnabled is bool
        && (!('hasHuggingfaceConfigured' in data) || data.hasHuggingfaceConfigured is bool)
        && data.queueTimeoutSec is number && data.queueTimeoutSec >= 10 && data.queueTimeoutSec <= 120
        && data.activeTurboMode is bool
        && data.updatedAt is timestamp;
    }

    function isValidUserAccessControl(data, userId) {
      return data.keys().hasAll(['userId', 'status', 'revokedAfterMs', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'status', 'revokedAfterMs', 'reason', 'updatedBy', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.status in ['active', 'revoked', 'blocked']
        && (data.revokedAfterMs is int || data.revokedAfterMs is float) && data.revokedAfterMs >= 0 && data.revokedAfterMs <= 9999999999999
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 300))
        && data.updatedBy is string && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, sessionId) {
      return data.keys().hasAll(['sessionId', 'userId', 'title', 'mode', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sessionId', 'userId', 'title', 'mode', 'preview', 'messages', 'createdAt', 'updatedAt'])
        && data.sessionId is string && data.sessionId == sessionId && isValidId(data.sessionId)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.mode in ['chat', 'agent', 'ocr', 'web']
        && (!('preview' in data) || (data.preview is string && data.preview.size() <= 240))
        && data.messages is list && data.messages.size() <= 80 && (data.messages.size() == 0 || data.messages[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiSkill(data, userId, skillId) {
      return data.keys().hasAll(['skillId', 'userId', 'name', 'slug', 'source', 'category', 'instructionsMarkdown', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['skillId', 'userId', 'name', 'slug', 'source', 'category', 'description', 'triggers', 'instructionsMarkdown', 'author', 'repo', 'installs', 'enabled', 'createdAt', 'updatedAt'])
        && data.skillId is string && data.skillId == skillId && isValidId(data.skillId)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140
        && data.source in ['builtin', 'skills.sh', 'custom']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 400))
        && (!('triggers' in data) || (data.triggers is string && data.triggers.size() <= 240))
        && data.instructionsMarkdown is string && data.instructionsMarkdown.size() >= 1 && data.instructionsMarkdown.size() <= 12000
        && (!('author' in data) || (data.author is string && data.author.size() <= 120))
        && (!('repo' in data) || (data.repo is string && data.repo.size() <= 200))
        && (!('installs' in data) || ((data.installs is int || data.installs is float) && data.installs >= 0 && data.installs <= 100000000))
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMcpConnector(data, userId, connectorId) {
      return data.keys().hasAll(['connectorId', 'userId', 'name', 'slug', 'providerType', 'category', 'transport', 'status', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['connectorId', 'userId', 'name', 'slug', 'providerType', 'category', 'description', 'endpointUrl', 'transport', 'authType', 'authCredentialMasked', 'toolsList', 'status', 'enabled', 'createdAt', 'updatedAt'])
        && data.connectorId is string && data.connectorId == connectorId && isValidId(data.connectorId)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120
        && data.providerType in ['builtin', 'catalog', 'custom']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 400))
        && (!('endpointUrl' in data) || (data.endpointUrl is string && data.endpointUrl.size() <= 512))
        && data.transport in ['builtin', 'http', 'sse']
        && (!('authType' in data) || data.authType in ['none', 'bearer', 'api_key'])
        && (!('authCredentialMasked' in data) || (data.authCredentialMasked is string && data.authCredentialMasked.size() <= 120))
        && (!('toolsList' in data) || (data.toolsList is list && data.toolsList.size() <= 40 && (data.toolsList.size() == 0 || data.toolsList[0] is string)))
        && data.status in ['connected', 'disconnected', 'error']
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Owner-Scoped Collection Match Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && isNotBlocked();
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        && isNotBlocked();
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(prefId) && isOwner(userId)
          && isValidUserPreferences(incoming(), userId)
          && incoming().updatedAt == request.time
          && isNotBlocked();
        allow update: if isValidId(userId) && isValidId(prefId) && isOwner(userId)
          && isValidUserPreferences(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['watchlist', 'currencySymbol', 'currencyPlacement', 'themeMode', 'currentLanguage', 'planTier', 'planExpiresAt', 'adFree', 'organizationId', 'updatedAt'])
          && isNotBlocked();
        allow delete: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(transactionId) && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(transactionId) && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'merchant', 'amount', 'category', 'status', 'paymentMethod', 'upiReference', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
      }

      match /invoices/{invoiceId} {
        allow get: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId)
          && isValidInvoice(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId)
          && isValidInvoice(incoming(), userId)
          && existing().paymentStatus != 'paid'
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['dueDate', 'senderName', 'senderDetails', 'senderTaxId', 'clientName', 'clientDetails', 'clientEmail', 'clientTaxId', 'templateStyle', 'paperFormat', 'items', 'subtotal', 'taxTotal', 'discountTotal', 'grandTotal', 'notes', 'upiId', 'payeeName', 'paypalId', 'paymentRegion', 'paymentStatus', 'paidAt', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId);
      }

      match /goals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(goalId) && isOwner(userId)
          && isValidGoal(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(goalId) && isOwner(userId);
      }

      match /portfolio/{portfolioId} {
        allow get: if isValidId(userId) && isValidId(portfolioId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(portfolioId) && isOwner(userId)
          && isValidStockPortfolio(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(portfolioId) && isOwner(userId)
          && isValidStockPortfolio(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['brokerName', 'totalValue', 'totalInvested', 'currency', 'notes', 'holdings', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(portfolioId) && isOwner(userId);
      }

      match /payout_settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(settingId) && isOwner(userId)
          && isValidPayoutSettings(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(settingId) && isOwner(userId)
          && isValidPayoutSettings(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['upiId', 'payeeName', 'bankName', 'accountHolder', 'accountNumber', 'ifscCode', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
      }

      match /chat_sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sessionId) && isOwner(userId)
          && isValidChatSession(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isNotBlocked();
        allow update: if isValidId(userId) && isValidId(sessionId) && isOwner(userId)
          && isValidChatSession(incoming(), userId, sessionId)
          && incoming().sessionId == existing().sessionId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'preview', 'messages', 'updatedAt'])
          && isNotBlocked();
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }

      match /ai_skills/{skillId} {
        allow get: if isValidId(userId) && isValidId(skillId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(skillId) && isOwner(userId)
          && isValidAiSkill(incoming(), userId, skillId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isNotBlocked();
        allow update: if isValidId(userId) && isValidId(skillId) && isOwner(userId)
          && isValidAiSkill(incoming(), userId, skillId)
          && incoming().skillId == existing().skillId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'category', 'description', 'triggers', 'instructionsMarkdown', 'enabled', 'updatedAt'])
          && isNotBlocked();
        allow delete: if isValidId(userId) && isValidId(skillId) && isOwner(userId);
      }

      match /mcp_connectors/{connectorId} {
        allow get: if isValidId(userId) && isValidId(connectorId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(connectorId) && isOwner(userId)
          && isValidMcpConnector(incoming(), userId, connectorId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isNotBlocked();
        allow update: if isValidId(userId) && isValidId(connectorId) && isOwner(userId)
          && isValidMcpConnector(incoming(), userId, connectorId)
          && incoming().connectorId == existing().connectorId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description', 'endpointUrl', 'transport', 'authType', 'authCredentialMasked', 'toolsList', 'status', 'enabled', 'updatedAt'])
          && isNotBlocked();
        allow delete: if isValidId(userId) && isValidId(connectorId) && isOwner(userId);
      }
    }

    // 5. Organization Workspaces (Admin Console + Owner Scoped)
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isValidId(orgId) && isSignedIn()
        && isValidOrganization(incoming(), orgId)
        && (isAdmin() || incoming().ownerUserId == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orgId) && isSignedIn()
        && isValidOrganization(incoming(), orgId)
        && (isAdmin() || (existing().ownerUserId == request.auth.uid && existing().status != 'churned'))
        && incoming().orgId == existing().orgId
        && incoming().ownerUserId == existing().ownerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'industry', 'seatCount', 'billingEmail', 'notes', 'updatedAt']));
      allow delete: if isValidId(orgId) && isAdmin();
    }

    // 6. Platform Analytics Events (Authenticated Append-Only Write, Strict Admin Read)
    match /analytics_events/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId) && isSignedIn()
        && isValidAnalyticsEvent(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 7. Hyperswitch Payment Records (Owner Read/Create, Admin Audit)
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(paymentId) && isSignedIn()
        && isValidGatewayPayment(incoming(), paymentId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 8. Vision Ideation Boards (Owner & Authenticated Workspace Sync)
    match /ideation_boards/{boardId} {
      allow get: if isValidId(boardId) && (isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isValidId(boardId) && isSignedIn()
        && isValidIdeationBoard(incoming(), boardId)
        && (incoming().ownerUserId == request.auth.uid || isAdmin())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(boardId) && isSignedIn()
        && isValidIdeationBoard(incoming(), boardId)
        && (existing().ownerUserId == request.auth.uid || isAdmin())
        && incoming().boardId == existing().boardId
        && incoming().ownerUserId == existing().ownerUserId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(boardId) && (isAdmin() || (isSignedIn() && existing().ownerUserId == request.auth.uid));
    }

    // 9. Admin Allowlist
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin()
        && isValidAdminUser(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // 10. Platform Payout Configuration (Admin-Only Private Banking + Signed-In Public UPI Routing)
    match /platform_config/payout {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidPlatformPayoutPrivate(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /platform_config/payout_public {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidPlatformPayoutPublic(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // 11. Platform Free AI Image Engine Configuration (Admin-Only Secrets + Signed-In Capability Flags)
    match /platform_config/ai_image {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidPlatformAiImagePrivate(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /platform_config/ai_image_public {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidPlatformAiImagePublic(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // 12. Administrator User Access Control (Revoke Sessions & Block Accounts)
    match /user_access/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isAdmin()
        && isValidUserAccessControl(incoming(), userId)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
