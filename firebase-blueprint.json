{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and identity metadata",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "displayName", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Synchronized watchlist, currency, language, monetization plan, and display settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "watchlist": {
          "type": "array"
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "currencyPlacement": {
          "type": "string",
          "enum": ["before", "after"]
        },
        "themeMode": {
          "type": "string",
          "enum": ["system", "light", "dark"]
        },
        "currentLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "team"]
        },
        "adFree": {
          "type": "boolean"
        },
        "organizationId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "watchlist", "currencySymbol", "currencyPlacement", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "User financial transaction record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "merchant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["completed", "pending"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "CARD", "CASH", "SCAN_RECEIPT", "INVOICE"]
        },
        "invoiceId": {
          "type": "string",
          "maxLength": 128
        },
        "upiReference": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "date", "merchant", "amount", "category", "status", "createdAt", "updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "User digital invoice and UPI payment record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "dueDate": {
          "type": "string",
          "maxLength": 32
        },
        "senderName": {
          "type": "string",
          "maxLength": 160
        },
        "senderDetails": {
          "type": "string",
          "maxLength": 400
        },
        "senderTaxId": {
          "type": "string",
          "maxLength": 64
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "clientDetails": {
          "type": "string",
          "maxLength": 400
        },
        "clientEmail": {
          "type": "string",
          "maxLength": 254
        },
        "clientTaxId": {
          "type": "string",
          "maxLength": 64
        },
        "industry": {
          "type": "string",
          "enum": ["RETAIL", "TECH", "DINING", "HEALTHCARE", "SERVICES"]
        },
        "templateStyle": {
          "type": "string",
          "enum": ["classic", "minimal", "corporate"]
        },
        "paperFormat": {
          "type": "string",
          "enum": ["a4", "letter", "thermal80"]
        },
        "items": {
          "type": "array"
        },
        "subtotal": {
          "type": "number"
        },
        "taxTotal": {
          "type": "number"
        },
        "discountTotal": {
          "type": "number"
        },
        "grandTotal": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        },
        "upiId": {
          "type": "string",
          "maxLength": 120
        },
        "payeeName": {
          "type": "string",
          "maxLength": 120
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "paid", "pending"]
        },
        "paidAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "invoiceNumber", "date", "clientName", "industry", "items", "subtotal", "taxTotal", "discountTotal", "grandTotal", "currency", "paymentStatus", "createdAt", "updatedAt"]
    },
