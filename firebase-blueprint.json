  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profile document"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": "UserPreferences",
      "description": "User watchlist, monetization plan, and regional/appearance settings"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Owner-scoped financial transactions"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Owner-scoped digital invoices"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Owner-scoped wealth goals"
    },
    "/users/{userId}/portfolio/{portfolioId}": {
      "schema": "StockPortfolio",
      "description": "Owner-scoped stock broking balance and holdings"
    },
    "/users/{userId}/payout_settings/{settingId}": {
      "schema": "PayoutSettings",
      "description": "Owner-scoped receiving UPI and bank payout configuration"
    },
    "/platform_config/payout": {
      "schema": "PlatformPayoutPrivate",
      "description": "Admin-only platform receiving UPI and bank settlement credentials"
    },
    "/platform_config/payout_public": {
      "schema": "PlatformPayoutPublic",
      "description": "Publicly readable masked UPI settlement details for customer checkout QR codes"
    },
    "/platform_config/ai_image": {
      "schema": "PlatformAiImagePrivate",
      "description": "Admin-only free AI image generation keys for AI Horde, Cloudflare Workers AI and Hugging Face Inference"
    },
    "/platform_config/ai_image_public": {
      "schema": "PlatformAiImagePublic",
      "description": "Publicly readable AI image engine availability flags"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Tracked organizations and freelancer workspaces managed in admin console"
    },
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Admin-readable activity, ad impression, affiliate, and revenue events"
    },
    "/payments/{paymentId}": {
      "schema": "GatewayPayment",
      "description": "Hyperswitch payment records readable by payment owner and platform admins"
    },
    "/ideation_boards/{boardId}": {
      "schema": "IdeationBoard",
      "description": "Collaborative Vision mind map, slide deck, and meeting notes"
    },
    "/admins/{userId}": {
      "schema": "AdminUser",
      "description": "Authorized platform admin records"
    }
  }
}
