    "GatewayPayment": {
      "title": "GatewayPayment",
      "description": "Hyperswitch payment transaction record across India and international rails",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 254
        },
        "userName": {
          "type": "string",
          "maxLength": 120
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "team"]
