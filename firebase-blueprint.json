        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP"]
        },
        "amount": {
          "type": "number"
        },
        "amountUsdEquivalent": {
          "type": "number"
        },
        "paymentRail": {
          "type": "string",
